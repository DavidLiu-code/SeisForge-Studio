{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seisforge.local/schemas/algorithm-manifest-v1.json",
  "title": "SeisForge external algorithm manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "category", "description", "protocol_version", "input_kinds", "output_kinds", "supports_progress", "supports_cancel", "parameters", "executable", "minimum_host_version"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256},
    "category": {"type": "string"},
    "description": {"type": "string"},
    "protocol_version": {"const": "seisforge.algorithm.v1"},
    "input_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "output_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "supports_progress": {"type": "boolean"},
    "supports_cancel": {"type": "boolean"},
    "parameters": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/parameter"}},
    "executable": {"type": "string", "minLength": 1},
    "minimum_host_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["integer", "number", "boolean", "string", "enum", "file", "range", "group"]},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "unit": {"type": "string"},
        "required": {"type": "boolean"},
        "default": {},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0, "description": "Allowed increment from min, or zero when min is absent. Values and range endpoints must align; floating representation noise is tolerated without rounding."},
        "options": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "parameters": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/parameter"}},
        "ui": {
          "type": "object",
          "description": "Optional placement in the host form; does not alter normalized values or requests.",
          "additionalProperties": false,
          "required": ["section"],
          "properties": {
            "section": {"enum": ["common", "advanced"]},
            "order": {"type": "integer", "minimum": 0, "maximum": 255, "default": 0}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "enum"}}}, "then": {"required": ["options"]}},
        {"if": {"properties": {"type": {"const": "group"}}}, "then": {"required": ["parameters"]}}
      ]
    }
  }
}
